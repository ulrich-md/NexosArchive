# Frontend del Archivo Nexos.
#
# Aquí SOLO van llaves públicas. Nunca la service role de Supabase, nunca
# credenciales de WordPress, nunca llaves de OpenAI ni de Anthropic: todo lo
# que viva en este archivo termina dentro del bundle que sirve el navegador
# (CLAUDE.md sección 6).
#
# Copia este archivo a `.env.local` (que está en .gitignore) y llénalo.

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Llave anon/publishable. Es pública por diseño: con RLS activado y sin
# ninguna policy de SELECT, no puede leer una sola fila de `articulos`.
VITE_SUPABASE_ANON_KEY=sb_publishable_...
