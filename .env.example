# Supabase — proyecto del Archivo Nexos
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Service role: SOLO para scripts locales y Edge Functions. Nunca en el frontend, nunca en git.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# WordPress de Nexos (metadata pública, fase 1). El valor por defecto ya apunta a producción.
WP_BASE_URL=https://www.nexos.com.mx/wp-json/wp/v2

# Fase 2 (cuerpo del artículo, requiere Application Password de WordPress).
# No es necesario para correr `npm run ingesta` en fase 1.
# WP_APP_USER=usuario
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Llave pública (la que iría en el navegador). Solo la usa `npm run verificar`
# para comprobar que NO puede leer el archivo. Es pública por diseño.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Claude — enriquecimiento (`npm run enriquecer`) y las Edge Functions.
# Nunca en el frontend, nunca en git.
ANTHROPIC_API_KEY=sk-ant-...
