node_modules/
dist/
.env
.env.local
logs/*.jsonl
logs/*.csv
!logs/.gitkeep
datos/
# Excepción: este sí se versiona. Registra qué firmas se decidió que NO son
# personas ("Cultura Nexos", "Juego de La Nueva Suprema Corte"). Es una decisión
# sobre el archivo, no un caché: si se pierde, la siguiente corrida vuelve a
# meter las cuentas de los blogs al índice de autores sin que nadie lo note.
!datos/firmas-institucionales.json
logs/*.log

# Scripts temporales de exploración en la raíz. Van aquí y no en el scratchpad
# porque los imports de paquete (dotenv, supabase-js) solo resuelven dentro del
# proyecto; el script que los crea los borra al terminar.
_*.mts
logs/*.txt

# Caché local del CLI de Supabase (detecta la versión de Postgres al hacer
# link/db push). No es contenido del proyecto.
supabase/.temp/

# `deno check`/`deno test` a veces escriben un lockfile en la raíz del repo
# en vez de dentro de la función que se está probando. No hay proyecto Deno
# en la raíz; el lockfile que sí cuenta es supabase/functions/buscar/deno.lock.
/deno.lock
